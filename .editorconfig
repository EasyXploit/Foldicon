root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,xml,csproj,vcxproj,props,targets,slnx,appxmanifest,manifest,resw,xaml}]
indent_size = 2

[*.{ps1,bat,cmd,sln}]
end_of_line = crlf

[*.iss]
charset = utf-8-bom
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
