<!-- WinUI 3 icon picker app, packaged as MSIX together with the context menu extension -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>Foldicon.App</RootNamespace>
    <AssemblyName>Foldicon</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Foldicon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- One runtime per package, so it only carries the native SQLite for its own architecture -->
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <!-- Carries the .NET runtime inside the package, so it installs on a PC without .NET -->
    <SelfContained>true</SelfContained>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- MSIX for the Store; scripts/Build-Installer.ps1 passes None and a self-contained Windows App SDK -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">MSIX</WindowsPackageType>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Local packages are signed by scripts/Sign-Package.ps1; the Store signs its own -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foldicon.Core\Foldicon.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Foldicon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Puts the context menu DLL, built before by MSBuild from the solution, at the package root -->
  <PropertyGroup>
    <ContextMenuDll>$(MSBuildThisFileDirectory)..\Foldicon.ContextMenu\bin\$(Platform)\$(Configuration)\Foldicon.ContextMenu.dll</ContextMenuDll>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(ContextMenuDll)')">
    <Content Include="$(ContextMenuDll)" Link="Foldicon.ContextMenu.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="WarnMissingContextMenu" BeforeTargets="Build" Condition="!Exists('$(ContextMenuDll)')">
    <Warning Text="Foldicon.ContextMenu.dll is not built for $(Platform)|$(Configuration); the package will have no context menu. Build Foldicon.slnx with MSBuild." />
  </Target>

  <!-- Puts the Fluent icon library, built before by MSBuild from the solution, and their license next to the app -->
  <PropertyGroup>
    <FluentIconsFolder>$(MSBuildThisFileDirectory)..\Foldicon.FluentIcons\</FluentIconsFolder>
    <FluentIconsDll>$(FluentIconsFolder)bin\$(Platform)\$(Configuration)\fluenticons.dll</FluentIconsDll>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(FluentIconsFolder)LICENSE" Link="fluenticons.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(FluentIconsDll)')">
    <Content Include="$(FluentIconsDll)" Link="fluenticons.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="WarnMissingFluentIcons" BeforeTargets="Build" Condition="!Exists('$(FluentIconsDll)')">
    <Warning Text="fluenticons.dll is not built for $(Platform)|$(Configuration); the package will have no Fluent icons. Build Foldicon.slnx with MSBuild." />
  </Target>

  <ItemGroup>
    <ProjectCapability Include="Msix" />
  </ItemGroup>
</Project>
