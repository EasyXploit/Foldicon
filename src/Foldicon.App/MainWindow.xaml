<?xml version="1.0" encoding="utf-8"?>
<!-- Picker window: search, one tab per library, grid of icons, preview and actions -->
<Window
  x:Class="Foldicon.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:models="using:Foldicon.App.Models">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root" RowSpacing="8" Padding="16,0,16,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindInvoked" />
      <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </Grid.KeyboardAccelerators>

    <!-- Title bar drawn over the content, with the folder being changed; the margin keeps it clear of the window buttons -->
    <Grid x:Name="TitleBar" Grid.Row="0" ColumnSpacing="12" VerticalAlignment="Center" Margin="0,0,138,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Source="Assets/Square44x44Logo.png" Width="16" Height="16" />
      <TextBlock x:Uid="AppTitle" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" />
      <TextBlock x:Name="FolderText" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
    </Grid>

    <AutoSuggestBox
      x:Name="SearchBox"
      x:Uid="SearchBox"
      Grid.Row="1"
      QueryIcon="Find"
      TextChanged="OnSearchTextChanged"
      QuerySubmitted="OnSearchSubmitted"
      KeyDown="OnSearchKeyDown" />

    <!-- One tab per library, scrolled sideways when they do not fit, with arrows only then -->
    <Grid Grid.Row="2" ColumnSpacing="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button x:Name="TabsBackButton" x:Uid="TabsBackButton" Background="Transparent" BorderThickness="0" Padding="8" Visibility="Collapsed" Click="OnTabsBackClick">
        <FontIcon Glyph="&#xE76B;" FontSize="12" />
      </Button>

      <ScrollViewer
        x:Name="LibraryScroller"
        Grid.Column="1"
        HorizontalScrollMode="Enabled"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollMode="Disabled"
        VerticalScrollBarVisibility="Disabled"
        ViewChanged="OnLibraryScrollChanged"
        SizeChanged="OnLibraryScrollerSizeChanged">
        <SelectorBar x:Name="LibraryBar" HorizontalAlignment="Left" SelectionChanged="OnLibraryChanged">
          <SelectorBarItem x:Uid="AllTab" IsSelected="True" />
        </SelectorBar>
      </ScrollViewer>

      <Button x:Name="TabsForwardButton" x:Uid="TabsForwardButton" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="8" Visibility="Collapsed" Click="OnTabsForwardClick">
        <FontIcon Glyph="&#xE76C;" FontSize="12" />
      </Button>
    </Grid>

    <Grid Grid.Row="3" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="272" />
      </Grid.ColumnDefinitions>

      <!-- Virtualized grid of icons; arrows move, Enter and double click apply -->
      <GridView
        x:Name="IconGrid"
        SelectionMode="Single"
        IsDoubleTapEnabled="True"
        SelectionChanged="OnIconSelected"
        DoubleTapped="OnIconDoubleTapped"
        KeyDown="OnGridKeyDown"
        ContainerContentChanging="OnContainerContentChanging">
        <GridView.ItemTemplate>
          <DataTemplate x:DataType="models:IconItem">
            <Grid Width="56" Height="56" ToolTipService.ToolTip="{x:Bind ToolTip}">
              <Image Source="{x:Bind Image, Mode=OneWay}" Width="32" Height="32" />
            </Grid>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>

      <ProgressRing x:Name="LoadingRing" IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <TextBlock x:Name="EmptyText" x:Uid="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />

      <!-- Preview of the selected icon at the sizes Explorer uses; only the largest one shrinks, so the rest stays visible -->
      <Grid Grid.Column="1" RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MaxHeight="256" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
          <Image x:Name="Preview256" Width="256" Height="256" />
        </Viewbox>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16">
          <Image x:Name="Preview48" Width="48" Height="48" VerticalAlignment="Bottom" />
          <Image x:Name="Preview32" Width="32" Height="32" VerticalAlignment="Bottom" />
          <Image x:Name="Preview24" Width="24" Height="24" VerticalAlignment="Bottom" />
          <Image x:Name="Preview16" Width="16" Height="16" VerticalAlignment="Bottom" />
        </StackPanel>
        <TextBlock x:Name="SelectedName" Grid.Row="2" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
        <TextBlock x:Name="SelectedReference" Grid.Row="3" IsTextSelectionEnabled="True" Opacity="0.7" />
      </Grid>
    </Grid>

    <InfoBar x:Name="ResultBar" Grid.Row="4" IsOpen="False" IsClosable="True">
      <InfoBar.ActionButton>
        <Button x:Name="UndoButton" x:Uid="UndoButton" Click="OnUndoClick" />
      </InfoBar.ActionButton>
    </InfoBar>

    <Grid Grid.Row="5" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ChooseFolderButton" x:Uid="ChooseFolderButton" Visibility="Collapsed" Click="OnChooseFolderClick" />
        <Button x:Name="RestoreButton" x:Uid="RestoreButton" Click="OnRestoreClick" />
        <Button x:Uid="MoreButton" VerticalAlignment="Stretch">
          <FontIcon Glyph="&#xE712;" FontSize="14" />
          <Button.Flyout>
            <MenuFlyout Placement="Top">
              <MenuFlyoutItem x:Name="RepairItem" x:Uid="RepairItem" Click="OnRepairClick" />
              <ToggleMenuFlyoutItem x:Name="RepairAtStartupItem" x:Uid="RepairAtStartupItem" Click="OnRepairAtStartupClick" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
      <Button x:Uid="CancelButton" Grid.Column="2" Click="OnCancelClick" />
      <Button x:Name="ApplyButton" x:Uid="ApplyButton" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="OnApplyClick" />
    </Grid>
  </Grid>
</Window>
