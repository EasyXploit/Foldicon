<?xml version="1.0" encoding="utf-8"?>
<!-- Window of the picker: search, one tab per library, grid of icons, preview and actions -->
<Window
  x:Class="Foldicon.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:models="using:Foldicon.App.Models">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root" RowSpacing="8" Padding="16,0,16,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindInvoked" />
      <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </Grid.KeyboardAccelerators>

    <!-- Title bar drawn over the content, with the folder being changed -->
    <StackPanel x:Name="TitleBar" Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
      <Image Source="Assets/Square44x44Logo.png" Width="16" Height="16" />
      <TextBlock x:Uid="AppTitle" Style="{StaticResource CaptionTextBlockStyle}" />
      <TextBlock x:Name="FolderText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <AutoSuggestBox
      x:Name="SearchBox"
      x:Uid="SearchBox"
      Grid.Row="1"
      QueryIcon="Find"
      TextChanged="OnSearchTextChanged"
      QuerySubmitted="OnSearchSubmitted"
      KeyDown="OnSearchKeyDown" />

    <SelectorBar x:Name="LibraryBar" Grid.Row="2" SelectionChanged="OnLibraryChanged">
      <SelectorBarItem x:Uid="AllTab" IsSelected="True" />
    </SelectorBar>

    <Grid Grid.Row="3" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="272" />
      </Grid.ColumnDefinitions>

      <!-- Virtualized grid of icons; arrows move, Enter and double click apply -->
      <GridView
        x:Name="IconGrid"
        SelectionMode="Single"
        IsDoubleTapEnabled="True"
        SelectionChanged="OnIconSelected"
        DoubleTapped="OnIconDoubleTapped"
        KeyDown="OnGridKeyDown"
        ContainerContentChanging="OnContainerContentChanging">
        <GridView.ItemTemplate>
          <DataTemplate x:DataType="models:IconItem">
            <Grid Width="56" Height="56" ToolTipService.ToolTip="{x:Bind ToolTip}">
              <Image Source="{x:Bind Image, Mode=OneWay}" Width="32" Height="32" />
            </Grid>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>

      <ProgressRing x:Name="LoadingRing" IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <TextBlock x:Name="EmptyText" x:Uid="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />

      <!-- Preview of the selected icon at the sizes Explorer uses -->
      <StackPanel Grid.Column="1" Spacing="12">
        <Border Width="256" Height="256" HorizontalAlignment="Left">
          <Image x:Name="Preview256" Width="256" Height="256" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Bottom">
          <Image x:Name="Preview48" Width="48" Height="48" VerticalAlignment="Bottom" />
          <Image x:Name="Preview32" Width="32" Height="32" VerticalAlignment="Bottom" />
          <Image x:Name="Preview24" Width="24" Height="24" VerticalAlignment="Bottom" />
          <Image x:Name="Preview16" Width="16" Height="16" VerticalAlignment="Bottom" />
        </StackPanel>
        <TextBlock x:Name="SelectedName" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
        <TextBlock x:Name="SelectedReference" IsTextSelectionEnabled="True" Opacity="0.7" />
      </StackPanel>
    </Grid>

    <InfoBar x:Name="ResultBar" Grid.Row="4" IsOpen="False" IsClosable="True">
      <InfoBar.ActionButton>
        <Button x:Name="UndoButton" x:Uid="UndoButton" Click="OnUndoClick" />
      </InfoBar.ActionButton>
    </InfoBar>

    <Grid Grid.Row="5" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button x:Name="RestoreButton" x:Uid="RestoreButton" Click="OnRestoreClick" />
      <Button x:Uid="CancelButton" Grid.Column="2" Click="OnCancelClick" />
      <Button x:Name="ApplyButton" x:Uid="ApplyButton" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="OnApplyClick" />
    </Grid>
  </Grid>
</Window>
